#!/usr/bin/env bash
# =============================================================================
# prune-diff-tracker — delete old diff-tracker session snapshots.
#
# Usage: prune-diff-tracker [days]
#   days  retention window; session dirs older than this are removed.
#         Defaults to $DIFF_TRACKER_RETENTION_DAYS, else 7.
#
# Safety:
#   - never removes the session currently in use ($PI_SESSION_ID)
#   - skips if another prune is already running (mkdir lock)
#   - skips if it already ran in the last hour (stamp file)
#   - exits quietly when diff-tracker storage does not exist
# =============================================================================
set -euo pipefail

ROOT="${DIFF_TRACKER_DIR:-$HOME/.pi/diff-tracker}"
SESSIONS="$ROOT/sessions"
DAYS="${1:-${DIFF_TRACKER_RETENTION_DAYS:-7}}"
STAMP="${TMPDIR:-/tmp}/pi-diff-tracker-prune.stamp"
LOCK="$SESSIONS/.prune.lock"

[[ -d "$SESSIONS" ]] || exit 0
[[ "$DAYS" =~ ^[0-9]+$ ]] || exit 2

# Throttle: at most one run per hour, regardless of how many shells start.
if [[ -f "$STAMP" ]]; then
  last="$(stat -f %m "$STAMP" 2>/dev/null || stat -c %Y "$STAMP" 2>/dev/null || echo 0)"
  now="$(date +%s)"
  (( now - last < 3600 )) && exit 0
fi

mkdir "$LOCK" 2>/dev/null || exit 0
trap 'rmdir "$LOCK" 2>/dev/null || true' EXIT

: > "$STAMP"

current="${PI_SESSION_ID:-}"
candidates=()

# Session dirs are UUIDs; the lock file is not a directory and is skipped anyway.
while IFS= read -r -d '' dir; do
  name="$(basename "$dir")"
  [[ -n "$current" && "$name" == "$current" ]] && continue
  candidates+=("$dir")
done < <(find "$SESSIONS" -mindepth 1 -maxdepth 1 -type d -name '*-*' -mtime +"$DAYS" -print0)

# Nothing to do: leave without paying for the size calculation.
if (( ${#candidates[@]} == 0 )); then
  exit 0
fi

freed_before="$(du -sk "$SESSIONS" 2>/dev/null | cut -f1 || echo 0)"
for dir in "${candidates[@]}"; do
  rm -rf -- "$dir"
done
freed_after="$(du -sk "$SESSIONS" 2>/dev/null | cut -f1 || echo 0)"

printf 'prune-diff-tracker: removed %d session(s) older than %d days, freed %d MB\n' \
  "${#candidates[@]}" "$DAYS" "$(( (freed_before - freed_after) / 1024 ))"
