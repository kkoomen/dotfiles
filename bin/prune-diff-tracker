#!/usr/bin/env bash
# =============================================================================
# prune-diff-tracker — shell-startup hook for diff-tracker retention.
#
# Usage: prune-diff-tracker [days]
#   days  retention window; defaults to $DIFF_TRACKER_RETENTION_DAYS, else 3.
#
# The rule lives in one place now: this delegates to `diff-tracker prune`, which
# removes sessions whose newest activity is older than the window, prunes older
# diffs inside surviving sessions, and never touches the active Pi session.
# Throttling, the lock, and the size report are the built-in's responsibility.
# =============================================================================
set -uo pipefail

TRACKER="${DIFF_TRACKER_BIN:-$HOME/.pi/agent/bin/diff-tracker}"
DAYS="${1:-${DIFF_TRACKER_RETENTION_DAYS:-3}}"

[[ -x "$TRACKER" ]] || exit 0
[[ -d "${DIFF_TRACKER_DIR:-$HOME/.pi/diff-tracker}/sessions" ]] || exit 0
[[ "$DAYS" =~ ^[0-9]+$ ]] || exit 2

exec "$TRACKER" prune --days "$DAYS" --quiet
